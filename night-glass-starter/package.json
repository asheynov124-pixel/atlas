{
  "name": "night-glass-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A mobile-first PWA starter in the Night Glass interface: swipe feed, action rail, sheets, toasts, four tabs, mock data, and visual checks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test tests/e2e",
    "visual": "playwright test tests/visual",
    "visual:update": "playwright test tests/visual/screens.spec.ts --update-snapshots",
    "visual:sheet": "node scripts/contact-sheet.mjs",
    "check": "npm run typecheck && npm test && npm run build && playwright test",
    "visual:update:docker": "docker run --rm -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble sh -c \"npm ci && npm run visual:update\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
