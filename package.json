{
  "name": "sixteen-bannehr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive coffee-table book about the house at 16 Bannehr Street.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
