    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "dexie": "^4.4.7",
    "immer": "^11.2.9",
