{
  "name": "meridian-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of the Meridian Product Architecture Specification (PAS-001 v1.1): Task Ledger, Gate Engine, Approvals Inbox, Continuum Memory, Fast Path router, Swarm Kernel, Initiative Engine, and HTTP API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_NO_WARNINGS=1 node --import tsx --test test/*.test.ts",
    "demo:diligence": "tsx src/demo/diligence.ts",
    "demo:initiative": "tsx src/demo/initiative.ts",
    "serve": "NODE_NO_WARNINGS=1 tsx src/app/main.ts",
    "start": "NODE_NO_WARNINGS=1 tsx src/app/main.ts",
    "make:sample-pdf": "node scripts/make-sample-production.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149"
  }
}
