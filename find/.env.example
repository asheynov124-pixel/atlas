# Copy to .env for local runs (npm run spike loads nothing automatically:
#   set -a; source .env; set +a; npm run spike
# On Vercel, set these in Project → Settings → Environment Variables. Never commit real values.

# --- required for Phase 0 ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
APP_PASSCODE=
SPIKE_TOKEN=            # Phase 0 endpoint only; delete afterwards

# --- optional model overrides (defaults in server/lib/env.ts) ---
# CLAUDE_VISION_MODEL=claude-opus-5-5
# CLAUDE_TAG_MODEL=claude-haiku-5-5
# GEMINI_MODEL=gemini-3.8-flash

# --- later phases ---
# XAI_API_KEY=            # v2 trending strip
# DAILY_SPEND_CAP_USD=5   # pool refill pauses when today's logged spend reaches this
