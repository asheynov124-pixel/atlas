# Copy to .env for local runs (npm run spike loads nothing automatically:
#   set -a; source .env; set +a; npm run spike
# On Netlify, set these in Site configuration → Environment variables. Never commit real values.

# --- required for Phase 0 ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
APP_PASSCODE=

# --- optional model overrides (defaults in server/lib/env.ts) ---
# CLAUDE_VISION_MODEL=claude-opus-5-5
# CLAUDE_TAG_MODEL=claude-opus-5-5
# GEMINI_MODEL=

# --- later phases ---
# XAI_API_KEY=            # v2 trending strip
# EBAY_CLIENT_ID=         # v2 vintage hunt
# EBAY_CLIENT_SECRET=
# DAILY_SPEND_CAP_USD=5   # pool refill pauses when today's logged spend reaches this
